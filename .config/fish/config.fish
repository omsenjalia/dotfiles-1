# ~/.config/fish/config.fish: DO NOT EDIT -- this file has been generated
# automatically by home-manager.

# Only execute this file once per shell.
set -q __fish_home_manager_config_sourced; and exit
set -g __fish_home_manager_config_sourced 1

source /nix/store/fpqcf5by1mhspvyyldr09n2plvhvaf9r-hm-session-vars.fish/etc/profile.d/hm-session-vars.fish

# Source handler functions

fish_config theme choose catppuccin-mocha

# themeing
set fish_greeting
set -g theme_display_date no
set -g theme_nerd_fonts yes
set -g theme_newline_cursor yes

status is-login; and begin

    # Login shell initialisation

end

status is-interactive; and begin

    # Abbreviations

    # Aliases
    alias df 'df -h'
    alias eza 'eza --icons auto --group --group-directories-first --header --no-permissions --octal-permissions'
    alias fd 'fd --hidden'
    alias jctl 'journalctl -p 3 -xb'
    alias la 'eza -a'
    alias lg lazygit
    alias ll 'eza -l'
    alias lla 'eza -la'
    alias ls eza
    alias lt 'eza --tree'
    alias mkdir 'mkdir -pv'
    alias rs 'systemctl reboot'

    # Interactive shell initialisation
    /nix/store/1fc3iszabni2f7rnvdx49db2350qck7n-fzf-0.72.0/bin/fzf --fish | source

    /nix/store/48wm0a2qb8q96fmlyj3cbfxj7h8bqfbf-zoxide-0.9.9/bin/zoxide init fish --cmd cd | source

    if test "$TERM" != dumb
        /nix/store/9b20lz5hla3573b8xn7j84d1c78y6sqm-starship-1.25.1/bin/starship init fish | source

    end

    /nix/store/s8vwakyivbh1bn67aghv2c4d5m28vzpa-nix-your-shell-1.4.10/bin/nix-your-shell fish | source

    if set -q GHOSTTY_RESOURCES_DIR
        source "$GHOSTTY_RESOURCES_DIR/shell-integration/fish/vendor_conf.d/ghostty-shell-integration.fish"
    end

    # add completions generated by Home Manager to $fish_complete_path
    begin
        set -l joined (string join " " $fish_complete_path)
        set -l prev_joined (string replace --regex "[^\s]*generated_completions.*" "" $joined)
        set -l post_joined (string replace $prev_joined "" $joined)
        set -l prev (string split " " (string trim $prev_joined))
        set -l post (string split " " (string trim $post_joined))
        set fish_complete_path $prev "/home/isabel/.local/share/fish/home-manager/generated_completions" $post
    end

    source /nix/store/f0fyvsrnfqlxfac2d40xqm3m3l5lg689-atuin-fish-config.fish

    if not functions -q __direnv_export_eval
        /nix/store/d9mff3xzmx9ilj83mif6819rpd7m8mj7-direnv-2.37.1/bin/direnv hook fish | source
    end

end
