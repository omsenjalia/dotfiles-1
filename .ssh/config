Host aur.archlinux.org
  User aur
  HostName aur.archlinux.org
  IdentityFile /home/om/.config/sops-nix/secrets/keys-aur

Host codeberg.org
  User git
  HostName codeberg.org
  IdentityFile /home/om/.config/sops-nix/secrets/keys-codeberg

Host github.com
  User git
  HostName github.com
  IdentityFile /home/om/.config/sops-nix/secrets/keys-gh

Host gitlab.com
  User git
  HostName gitlab.com

Host *
  ForwardAgent no
  ServerAliveInterval 0
  ServerAliveCountMax 3
  Compression yes
  AddKeysToAgent no
  HashKnownHosts yes
  UserKnownHostsFile ~/.ssh/known_hosts
  ControlMaster no
  ControlPath ~/.ssh/master-%r@%n:%p
  ControlPersist no
